# Set this to the image you publish for community users.
# Examples:
#   CENCURITY_IMAGE=ghcr.io/<owner>/cencurity-community:2026-03-12-secfix
#   CENCURITY_IMAGE=<dockerhub_user>/cencurity-community:2026-03-12-secfix
CENCURITY_IMAGE=

# Optional: control image pulling behavior (always|missing|never|if_not_present)
CENCURITY_PULL_POLICY=if_not_present
